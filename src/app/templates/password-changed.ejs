<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Password Changed Successfully - Jasivo Lifestyle</title>
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body { 
      margin: 0; 
      padding: 0; 
      width: 100% !important; 
      background-color: #f1eff5; 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
      -webkit-font-smoothing: antialiased;
    }
    
    @media screen and (max-width: 600px) {
      .wrapper-padding { padding: 16px 8px !important; }
      .email-container { width: 100% !important; border-radius: 16px !important; }
      .header-padding { padding: 32px 20px 28px 20px !important; }
      .content-padding { padding: 30px 22px !important; }
      .btn-login { width: 100% !important; display: block !important; box-sizing: border-box; text-align: center !important; padding: 16px 20px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f1eff5;">

  <!-- Preheader Text -->
  <div style="display: none; max-height: 0px; overflow: hidden; mso-hide: all;">
    Your Jasivo Lifestyle account password has been changed successfully. If this wasn't you, secure your account immediately.
  </div>

  <!-- Main Outer Wrapper -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapper-padding" style="background-color: #f1eff5; padding: 40px 12px;">
    <tr>
      <td align="center">

        <!-- Main Email Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" class="email-container" style="max-width: 850px; width: 100%; background-color: #ffffff; border-radius: 22px; overflow: hidden; border: 1px solid #e5e0ee; box-shadow: 0 20px 45px rgba(30, 11, 54, 0.09);">
          
          <!-- Top Accent Bar (Lemon Green) -->
          <tr>
            <td style="background-color: #A3E635; height: 5px; font-size: 0; line-height: 0;">&nbsp;</td>
          </tr>

          <!-- PREMIUM HERO HEADER -->
          <tr>
            <td align="center" class="header-padding" style="background-color: #1E0B36; background-image: linear-gradient(135deg, #1E0B36 0%, #34125E 65%, #1E0B36 100%); padding: 40px 32px 34px 32px; text-align: center;">
              
              <% if (typeof whiteLogoUrl !== 'undefined' && whiteLogoUrl) { %>
              <a href="<%= websiteUrl || 'https://jasivolifestyle.com' %>" target="_blank" style="text-decoration: none; display: inline-block; margin-bottom: 22px;">
                <img 
                  src="<%= whiteLogoUrl %>" 
                  alt="Jasivo Lifestyle" 
                  width="190" 
                  style="display: block; max-width: 190px; height: auto; margin: 0 auto;"
                />
              </a>
              <% } %>

              <!-- Success Pill Badge -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 auto 14px auto;">
                <tr>
                  <td style="background-color: rgba(163, 230, 53, 0.16); border: 1px solid #A3E635; color: #A3E635; font-size: 11px; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; padding: 6px 16px; border-radius: 50px;">
                    &#10004; Security Confirmation
                  </td>
                </tr>
              </table>

              <!-- Hero Title -->
              <h1 style="margin: 0; font-size: 25px; font-weight: 800; color: #ffffff; letter-spacing: -0.3px; line-height: 1.3;">
                Password Changed Successfully
              </h1>
            </td>
          </tr>

          <!-- BODY SECTION -->
          <tr>
            <td class="content-padding" style="padding: 38px 44px 36px 44px; color: #2a2235;">
              
              <!-- Greeting -->
              <p style="margin: 0 0 14px 0; font-size: 17px; font-weight: 700; color: #1E0B36;">
                Hi<%= typeof userName !== 'undefined' && userName ? ' ' + userName : '' %>,
              </p>

              <!-- Confirmation Copy -->
              <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.7; color: #4e4659;">
                This email confirms that the password for your <strong>Jasivo Lifestyle</strong> account has been updated successfully. You can now sign in using your new password.
              </p>

              <!-- ACTIVITY SUMMARY CARD -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 22px 0 28px 0; background-color: #faf9fc; border: 1px solid #e9e3f2; border-radius: 14px;">
                <tr>
                  <td style="padding: 18px 22px;">
                    <p style="margin: 0 0 10px 0; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #6b5b7b;">
                      Change Summary
                    </p>
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 13.5px; color: #362e42;">
                      <tr>
                        <td style="padding: 4px 0; color: #6e5f80; width: 35%;">Status:</td>
                        <td style="padding: 4px 0; font-weight: 700; color: #3f6212;">&#9989; Password Updated</td>
                      </tr>
                      <tr>
                        <td style="padding: 4px 0; color: #6e5f80;">Date &amp; Time:</td>
                        <td style="padding: 4px 0; font-weight: 600; color: #1E0B36;">
                          <%= typeof changedAt !== 'undefined' && changedAt ? changedAt : new Date().toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
                        </td>
                      </tr>
                      <% if (typeof ipAddress !== 'undefined' && ipAddress) { %>
                      <tr>
                        <td style="padding: 4px 0; color: #6e5f80;">IP Address:</td>
                        <td style="padding: 4px 0; font-weight: 600; color: #1E0B36;"><%= ipAddress %></td>
                      </tr>
                      <% } %>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- PRIMARY CTA BUTTON -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 26px 0 30px 0;">
                <tr>
                  <td align="center">
                    <a 
                      href="<%= typeof loginUrl !== 'undefined' && loginUrl ? loginUrl : (websiteUrl || 'https://jasivolifestyle.com') %>" 
                      target="_blank" 
                      class="btn-login"
                      style="display: inline-block; background-color: #A3E635; background-image: linear-gradient(180deg, #bef264 0%, #99e028 100%); color: #1E0B36; font-size: 15px; font-weight: 800; text-decoration: none; padding: 15px 42px; border-radius: 12px; border: 1px solid #84cc16; box-shadow: 0 6px 16px rgba(132, 204, 22, 0.3);"
                    >
                      Log In to Your Account &nbsp;&rarr;
                    </a>
                  </td>
                </tr>
              </table>

              <!-- UNAUTHORIZED ACTION WARNING BOX -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fef2f2; border-left: 4px solid #ef4444; border-radius: 0 8px 8px 0;">
                <tr>
                  <td style="padding: 14px 16px; font-size: 13px; line-height: 1.55; color: #991b1b;">
                    <strong>Didn't make this change?</strong> If you did not change your password, your account may be compromised. Please reset your password immediately or contact us at 
                    <a href="mailto:<%= supportEmail || 'support@jasivolifestyle.com' %>" style="color: #991b1b; font-weight: 700; text-decoration: underline;">
                      <%= supportEmail || 'support@jasivolifestyle.com' %>
                    </a>.
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- LIGHT PREMIUM FOOTER -->
          <tr>
            <td style="background-color: #faf9fc; padding: 28px 36px; border-top: 1px solid #ece8f2; text-align: center;">
              
              <% if (typeof darkLogoUrl !== 'undefined' && darkLogoUrl) { %>
              <a href="<%= websiteUrl || '#' %>" target="_blank" style="text-decoration: none; display: inline-block;">
                <img 
                  src="<%= darkLogoUrl %>" 
                  alt="Jasivo Lifestyle" 
                  width="130" 
                  style="display: block; max-width: 130px; height: auto; margin: 0 auto 12px auto;"
                />
              </a>
              <% } %>

              <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #1E0B36;">
                Jasivo Lifestyle Bangladesh
              </p>
              <p style="margin: 0 0 14px 0; font-size: 12px; color: #7e738c;">
                This is an automated security notification. Please do not reply directly to this email.
              </p>

              <p style="margin: 0 0 14px 0; font-size: 12px;">
                <a href="<%= websiteUrl || '#' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Visit Store</a>
                <span style="color: #cbd5e1; margin: 0 8px;">|</span>
                <a href="mailto:<%= supportEmail || 'support@jasivolifestyle.com' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Customer Support</a>
                <span style="color: #cbd5e1; margin: 0 8px;">|</span>
                <a href="<%= privacyUrl || '#' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Privacy Policy</a>
              </p>

              <p style="margin: 0; font-size: 11px; color: #9c92a8; border-top: 1px solid #ece8f2; padding-top: 14px;">
                &copy; <%= new Date().getFullYear() %> Jasivo Lifestyle. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>