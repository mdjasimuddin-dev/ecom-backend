<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Reset Your Password - Jasivo Lifestyle</title>
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body { 
      margin: 0; 
      padding: 0; 
      width: 100% !important; 
      background-color: #f1eff5; 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
      -webkit-font-smoothing: antialiased;
    }
    
    @media screen and (max-width: 600px) {
      .wrapper-padding { padding: 16px 8px !important; }
      .email-container { width: 100% !important; border-radius: 16px !important; }
      .header-padding { padding: 32px 20px 28px 20px !important; }
      .content-padding { padding: 30px 22px !important; }
      .btn-reset { width: 100% !important; display: block !important; box-sizing: border-box; text-align: center !important; padding: 16px 20px !important; }
      .otp-digits { font-size: 28px !important; letter-spacing: 6px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f1eff5;">

  <!-- Preheader Text -->
  <div style="display: none; max-height: 0px; overflow: hidden; mso-hide: all;">
    Password reset request for your Jasivo Lifestyle account. Use the verification code or link inside to set a new password.
  </div>

  <!-- Main Outer Wrapper -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapper-padding" style="background-color: #f1eff5; padding: 40px 12px;">
    <tr>
      <td align="center">

        <!-- Main Email Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" class="email-container" style="max-width: 850px; width: 100%; background-color: #ffffff; border-radius: 22px; overflow: hidden; border: 1px solid #e5e0ee; box-shadow: 0 20px 45px rgba(30, 11, 54, 0.09);">
          
          <!-- Top Accent Bar (Lemon Green) -->
          <tr>
            <td style="background-color: #A3E635; height: 5px; font-size: 0; line-height: 0;">&nbsp;</td>
          </tr>

          <!-- PREMIUM HERO HEADER -->
          <tr>
            <td align="center" class="header-padding" style="background-color: #1E0B36; background-image: linear-gradient(135deg, #1E0B36 0%, #34125E 65%, #1E0B36 100%); padding: 40px 32px 34px 32px; text-align: center;">
              
              <% if (typeof whiteLogoUrl !== 'undefined' && whiteLogoUrl) { %>
              <a href="<%= websiteUrl || 'https://jasivolifestyle.com' %>" target="_blank" style="text-decoration: none; display: inline-block; margin-bottom: 22px;">
                <img 
                  src="<%= whiteLogoUrl %>" 
                  alt="Jasivo Lifestyle" 
                  width="190" 
                  style="display: block; max-width: 190px; height: auto; margin: 0 auto;"
                />
              </a>
              <% } %>

              <!-- Security Pill Badge -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 auto 14px auto;">
                <tr>
                  <td style="background-color: rgba(163, 230, 53, 0.14); border: 1px solid rgba(163, 230, 53, 0.45); color: #A3E635; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; padding: 6px 16px; border-radius: 50px;">
                    &#128274; Password Recovery
                  </td>
                </tr>
              </table>

              <!-- Hero Title -->
              <h1 style="margin: 0; font-size: 25px; font-weight: 800; color: #ffffff; letter-spacing: -0.3px; line-height: 1.3;">
                Reset Your Password
              </h1>
            </td>
          </tr>

          <!-- BODY SECTION -->
          <tr>
            <td class="content-padding" style="padding: 38px 44px 36px 44px; color: #2a2235;">
              
              <!-- Greeting -->
              <p style="margin: 0 0 14px 0; font-size: 17px; font-weight: 700; color: #1E0B36;">
                Hello<%= typeof userName !== 'undefined' && userName ? ' ' + userName : '' %>,
              </p>

              <!-- Message -->
              <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.7; color: #4e4659;">
                We received a request to reset the password for your <strong>Jasivo Lifestyle</strong> account. Use the verification code below<% if (typeof resetUrl !== 'undefined' && resetUrl) { %> or click the reset button<% } %> to choose a new password:
              </p>

              <!-- OTP DISPLAY BOX (Supports both `otp` and `redisOTP`) -->
              <!-- <% const codeToDisplay = typeof otp !== 'undefined' ? otp : (typeof redisOTP !== 'undefined' ? redisOTP : null); %> -->
              <% if (otp) { %>
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0; background-color: #1E0B36; background-image: linear-gradient(135deg, #1E0B36 0%, #2e1054 100%); border: 2px solid #A3E635; border-radius: 16px; box-shadow: 0 10px 25px rgba(30, 11, 54, 0.14);">
                <tr>
                  <td align="center" style="padding: 24px 20px;">
                    <p style="margin: 0 0 8px 0; font-size: 11px; text-transform: uppercase; letter-spacing: 1.8px; color: #bef264; font-weight: 700;">
                      Password Reset OTP Code
                    </p>
                    <p class="otp-digits" style="margin: 0; font-size: 36px; font-weight: 900; letter-spacing: 10px; color: #ffffff; font-family: 'Courier New', Courier, monospace;">
                      <%= otp %>
                    </p>
                    <p style="margin: 10px 0 0 0; font-size: 12px; color: #cbbad9;">
                      This code will expire in <strong><%= typeof expiryMinutes !== 'undefined' ? expiryMinutes : 5 %> minutes</strong>
                    </p>
                  </td>
                </tr>
              </table>
              <% } %>

              <!-- OPTIONAL RESET LINK BUTTON -->
              <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
              <% if (otp) { %>
              <p style="margin: 20px 0 14px 0; text-align: center; font-size: 12px; color: #6e5f80; font-weight: 700; letter-spacing: 0.8px;">
                — OR RESET DIRECTLY —
              </p>
              <% } %>
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 16px 0 26px 0;">
                <tr>
                  <td align="center">
                    <a 
                      href="<%= resetUrl %>" 
                      target="_blank" 
                      class="btn-reset"
                      style="display: inline-block; background-color: #A3E635; background-image: linear-gradient(180deg, #bef264 0%, #99e028 100%); color: #1E0B36; font-size: 15px; font-weight: 800; text-decoration: none; padding: 15px 40px; border-radius: 12px; border: 1px solid #84cc16; box-shadow: 0 6px 16px rgba(132, 204, 22, 0.3);"
                    >
                      Reset Password &nbsp;&rarr;
                    </a>
                  </td>
                </tr>
              </table>
              <% } %>

              <!-- Security Warning Box -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fef2f2; border-left: 4px solid #ef4444; border-radius: 0 8px 8px 0; margin-top: 10px;">
                <tr>
                  <td style="padding: 14px 16px; font-size: 13px; line-height: 1.55; color: #991b1b;">
                    <strong>Security Notice:</strong> Never share this code or link with anyone. Jasivo Lifestyle will never ask for your password or OTP. If you did not request a password reset, please ignore this email or contact our support team immediately.
                  </td>
                </tr>
              </table>

              <!-- Fallback URL if resetUrl is passed -->
              <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
              <hr style="border: 0; border-top: 1px solid #ede9f4; margin: 24px 0 16px 0;" />
              <p style="margin: 0 0 6px 0; font-size: 12px; color: #7e738c;">
                Trouble clicking the button? Copy and paste this URL into your browser:
              </p>
              <p style="margin: 0; font-size: 11.5px; line-height: 1.5; word-break: break-all;">
                <a href="<%= resetUrl %>" target="_blank" style="color: #4c1d95; text-decoration: underline;">
                  <%= resetUrl %>
                </a>
              </p>
              <% } %>

            </td>
          </tr>

          <!-- LIGHT PREMIUM FOOTER -->
          <tr>
            <td style="background-color: #faf9fc; padding: 28px 36px; border-top: 1px solid #ece8f2; text-align: center;">
              
              <% if (typeof darkLogoUrl !== 'undefined' && darkLogoUrl) { %>
              <a href="<%= websiteUrl || '#' %>" target="_blank" style="text-decoration: none; display: inline-block;">
                <img 
                  src="<%= darkLogoUrl %>" 
                  alt="Jasivo Lifestyle" 
                  width="130" 
                  style="display: block; max-width: 130px; height: auto; margin: 0 auto 12px auto;"
                />
              </a>
              <% } %>

              <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #1E0B36;">
                Jasivo Lifestyle Bangladesh
              </p>
              <p style="margin: 0 0 14px 0; font-size: 12px; color: #7e738c;">
                This is an automated security message. Please do not reply directly to this email.
              </p>

              <p style="margin: 0 0 14px 0; font-size: 12px;">
                <a href="<%= websiteUrl || '#' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Visit Store</a>
                <span style="color: #cbd5e1; margin: 0 8px;">|</span>
                <a href="mailto:<%= supportEmail || 'support@jasivolifestyle.com' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Customer Support</a>
                <span style="color: #cbd5e1; margin: 0 8px;">|</span>
                <a href="<%= privacyUrl || '#' %>" style="color: #581c87; text-decoration: none; font-weight: 600;">Privacy Policy</a>
              </p>

              <p style="margin: 0; font-size: 11px; color: #9c92a8; border-top: 1px solid #ece8f2; padding-top: 14px;">
                &copy; <%= new Date().getFullYear() %> Jasivo Lifestyle. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>