model User {
  id        String   @id @default(uuid())
  name      String @db.VarChar(255)
  email     String   @unique
  password  String
  phone     String?  @unique
  activeStatus ActiveStatus @default(ACTIVE)
  role      UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  profile Profile?

  @@map("Users")
}