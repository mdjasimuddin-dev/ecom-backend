model PasswordResetHistory {
  id String @id @default(uuid())

  ipAddress      String?
  device         String?
  deviceModel    String?
  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  userAgent      String?

  changedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([changedAt])
}
