model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName String // অর্ডারের সময়ের নাম ও দাম স্ন্যাপশট হিসেবে রাখা
  size        String
  color       String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  @@index([orderId])
  @@map("order_items")
}
